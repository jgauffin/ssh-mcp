{
  "name": "ssh-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "An SSH MCP server that cannot act without explicit human consent",
  "type": "module",
  "bin": {
    "ssh-mcp": "./dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ppk-to-openssh": "^3.2.0",
    "smol-toml": "^1.7.1",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
