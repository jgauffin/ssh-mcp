{
  "name": "ssh-mcp",
  "version": "0.2.1",
  "private": true,
  "description": "An SSH MCP server that cannot act without explicit human consent",
  "type": "module",
  "bin": {
    "ssh-mcp": "./dist/main.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "ppk-to-openssh": "^3.2.0",
    "smol-toml": "^1.9.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "@types/ssh2": "^1.15.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
